<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>cn.jiebaba.kanban</groupId>
    <artifactId>kanban-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>kanban-backend</name>
    <description>DataV-style kanban backend built on summer-boot + JDK 25</description>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>
    <dependencies>
        <dependency>
            <groupId>cn.jiebaba.summer</groupId>
            <artifactId>summer-boot</artifactId>
            <version>4.2.0</version>
        </dependency>
        <dependency>
            <groupId>cn.jiebaba.summer</groupId>
            <artifactId>summer-ai</artifactId>
            <version>4.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.12</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>

    </dependencies>
    <build>
        <finalName>kanban-backend</finalName>
        <plugins>
           <plugin>
               <groupId>cn.jiebaba.summer</groupId>
               <artifactId>summer-pack-maven-plugin</artifactId>
               <executions>
                   <execution>
                       <goals><goal>repackage</goal></goals>
                       <configuration>
                           <startClass>cn.kanban.Application</startClass>
                       </configuration>
                   </execution>
                   </executions>
                   <version>4.2.0</version>
               </plugin>
        </plugins>
    </build>
</project>
